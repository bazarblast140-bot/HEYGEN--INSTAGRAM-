# HeyGen API key -> https://app.heygen.com/settings?nav=API
HEYGEN_API_KEY=your_heygen_api_key_here

# Server port for the web UI (optional, default 3000)
PORT=3000

# ---- Daily market-reel pipeline ----------------------------------------
# The presenter panel in the hybrid layout.
#
# The account holds two kinds of presenter, and they are NOT interchangeable:
#   digital_twin (video clone) -> HEYGEN_AVATAR_KIND=avatar
#   photo_avatar               -> HEYGEN_AVATAR_KIND=talking_photo
# Sending the wrong one fails with a bare "not found", so set the kind explicitly
# rather than relying on the lookup.
#
# "Rajesh Video 1" — video clone, 720x1280 portrait, supports the avatar_v engine.
HEYGEN_AVATAR_ID=43ea820171e04d0eb3c4e457124c3828
HEYGEN_AVATAR_KIND=avatar
HEYGEN_ENGINE=avatar_v
HEYGEN_VOICE_ID=ad3099687f824940811e3fb3ec3e3beb

# Speech synthesis carries the narration whenever the avatar allowance is gone,
# so the reel keeps Rajesh's voice even on a month with no avatar minutes left.
# Run `node pipeline/heygen-doctor.js` (or the "HeyGen doctor" workflow) once to
# find the real REST path, then pin it here to skip the probing.
HEYGEN_SPEECH_PATH=
HEYGEN_TTS_LANGUAGE=hi

# ---- Whose text-to-speech ----------------------------------------------
# The voice is a provider, not a hard dependency on HeyGen. Whichever is
# configured answers; VOICE_PROVIDER forces one.
#
# HeyGen's /v1/tts.generate is the right endpoint but answers 403 to an API key
# on the free plan. Proven, not assumed: the same request returns 401 with an
# unrecognised Authorization header and 403 with X-Api-Key, and a service only
# distinguishes those two when it has authenticated you and is refusing on
# permission. So this is a plan limit, not a header mistake.
#
# ElevenLabs is the fallback: clone the voice there once, then the daily build
# never touches HeyGen for audio. Use the /with-timestamps endpoint -- it costs
# the same and returns the alignment that puts beat cuts in pauses.
VOICE_PROVIDER=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# The photo avatar, kept for reference:
#   HEYGEN_AVATAR_ID=976292674ea5406591a36443e2feb17f
#   HEYGEN_AVATAR_KIND=talking_photo
#   HEYGEN_ENGINE=            (leave empty; photo avatars default to avatar_iv)
#   HEYGEN_VOICE_ID=a1b2ea9b4b3c443fb3b87d32c9794516

# Fallbacks for the standalone web UI / CLI when no id is chosen in the request.
DEFAULT_AVATAR_ID=
DEFAULT_VOICE_ID=

# ---- Market data -------------------------------------------------------
# A key is not optional for the scheduled build. Swept from inside GitHub
# Actions: Stooq answers HTML to every URL variant on both hosts, and Yahoo
# answers 429 on both query hosts. They still work from a laptop, so they stay
# in the chain -- but a 7am job cannot depend on them.
#
# Set either one. Whichever has a key answers first.
#   Twelve Data    -> https://twelvedata.com
#   Alpha Vantage  -> https://www.alphavantage.co/support/#api-key
TWELVEDATA_API_KEY=
ALPHAVANTAGE_API_KEY=

# ---- Free stock footage (b-roll) ---------------------------------------
# Both free. Keys take a minute to create and cut HeyGen spend hard, because
# the avatar then only has to cover the hook instead of the whole reel.
#   Pexels  -> https://www.pexels.com/api/
#   Pixabay -> https://pixabay.com/api/docs/
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ---- Instagram publishing ----------------------------------------------
# Instagram has two publishing surfaces. Run `node pipeline/publish-reel.js --whoami`
# to find out which one this token and account actually work on, then pin it here.
#   facebook  -> graph.facebook.com,  Page token,  account id looks like 17841…
#   instagram -> graph.instagram.com, IG user token, no Facebook Page
IG_SURFACE=facebook

IG_USER_ID=17841410293109609
IG_ACCESS_TOKEN=

# Needed only by pipeline/token-tool.js, to turn the Graph API Explorer's
# short-lived token into one that lasts. Never commit the secret.
FB_APP_ID=1690836568687131
FB_APP_SECRET=
FB_PAGE_ID=691172017411768

# Override only if the defaults stop working (the version is an unverified guess).
# IG_API_VERSION=v23.0
