# HeyGen API key -> https://app.heygen.com/settings?nav=API
HEYGEN_API_KEY=your_heygen_api_key_here

# Server port for the web UI (optional, default 3000)
PORT=3000

# ---- Daily market-reel pipeline ----------------------------------------
# The presenter panel in the hybrid layout. Paste the ids from HeyGen here and
# the pipeline picks them up with no code change. Whether the id is a studio
# avatar or a photo avatar is detected automatically — there is nothing else to set.
HEYGEN_AVATAR_ID=976292674ea5406591a36443e2feb17f
HEYGEN_VOICE_ID=a1b2ea9b4b3c443fb3b87d32c9794516

# Fallbacks for the standalone web UI / CLI when no id is chosen in the request.
DEFAULT_AVATAR_ID=
DEFAULT_VOICE_ID=

# ---- Free stock footage (b-roll) ---------------------------------------
# Both free. Keys take a minute to create and cut HeyGen spend hard, because
# the avatar then only has to cover the hook instead of the whole reel.
#   Pexels  -> https://www.pexels.com/api/
#   Pixabay -> https://pixabay.com/api/docs/
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ---- Instagram publishing ----------------------------------------------
# Instagram Business account id (not the @handle) and a long-lived token with
# instagram_basic + instagram_content_publish.
IG_USER_ID=
IG_ACCESS_TOKEN=
