# HeyGen API key -> https://app.heygen.com/settings?nav=API
HEYGEN_API_KEY=your_heygen_api_key_here

# Server port for the web UI (optional, default 3000)
PORT=3000

# ---- Daily market-reel pipeline ----------------------------------------
# The presenter panel in the hybrid layout. Paste the ids from HeyGen here and
# the pipeline picks them up with no code change.
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=

# Fallbacks for the standalone web UI / CLI when no id is chosen in the request.
DEFAULT_AVATAR_ID=
DEFAULT_VOICE_ID=
